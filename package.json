{
  "name": "@fxhxyz/prettier-config",
  "version": "2.1.6",
  "type": "module",
  "description": "My professional prettier config",
  "main": "./.prettierrc.json",
  "prettier": "./.prettierrc.json",
  "keywords": [
    "typescript",
    "prettier",
    "javascript",
    "prettier config",
    "config"
  ],
  "files": [
    "./misc/.prettierignore",
    "./misc/.editorconfig",
    "./dist/prettierrc.cjs",
    "./dist/prettierrc.js",
    ".prettierrc.json",
    ".prettierrc.js",
    "rollup.config.js",
    ".gitignore",
    "license.md",
    "readme.md",
    ".npmignore"
  ],
  "exports": {
    ".": {
      "require": "./dist/.prettierrc.cjs",
      "import": "./dist/.prettierrc.js",
      "default": "./dist/.prettierrc.js"
    }
  },
  "author": {
    "name": "fxhxyz4",
    "email": "fxhsec@proton.me",
    "url": "https://fxhxyz.vercel.app/"
  },
  "homepage": "https://github.com/fxhxyz4/prettier-config",
  "bugs": "https://github.com/fxhxyz4/prettier-config/issues",
  "repository": {
    "type": "git",
    "url": "git://github.com/fxhxyz4/prettier-config.git"
  },
  "maintainers": [
    {
      "name": "fxhxyz4",
      "email": "fxhsec@proton.me"
    }
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rollup -c",
    "format": "prettier --write .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^x.x.x",
    "@rollup/plugin-json": "^6.1.0",
    "prettier": "^3.x.x",
    "prettier-plugin-multiline-arrays": "^x.x.x",
    "rollup": "^4.x.x"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  }
}
